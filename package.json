{
  "name": "atoms-demo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @atoms/frontend dev",
    "dev:backend": "pnpm --filter @atoms/backend dev",
    "openspec": "XDG_CONFIG_HOME=\"$PWD/.config\" openspec",
    "playwright": "bash .agents/skills/playwright/scripts/playwright_cli.sh",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:verification && pnpm test:contracts && pnpm --filter @atoms/backend test && pnpm --filter @atoms/frontend test",
    "test:contracts": "node --test scripts/prepare-contracts.test.mjs",
    "test:manager": "node --test scripts/manager.test.mjs",
    "test:infra": "node --test scripts/infra.test.mjs",
    "check": "node scripts/prepare-contracts.mjs && pnpm lint && pnpm typecheck && pnpm test",
    "verify": "node scripts/verify.mjs --profile full",
    "smoke": "pnpm build && node scripts/smoke.cjs",
    "prepare:template": "node scripts/prepare-company-template.mjs",
    "test:template": "node --test scripts/prepare-company-template.test.mjs",
    "smoke:template": "node scripts/template-smoke.cjs && node --test scripts/template-smoke-control.test.mjs",
    "model:probe": "pnpm --filter @atoms/backend model:probe",
    "model:probe:built": "pnpm --filter @atoms/backend model:probe:built",
    "generation:smoke": "pnpm --filter @atoms/backend generation:smoke",
    "generation:smoke:built": "pnpm --filter @atoms/backend generation:smoke:built",
    "smoke:projects": "node scripts/project-smoke.cjs && node --test scripts/project-smoke-control.test.mjs",
    "smoke:generation-stream": "node scripts/generation-stream-smoke.cjs",
    "smoke:candidate": "node scripts/candidate-smoke.cjs",
    "smoke:workspace": "node scripts/workspace-smoke.cjs",
    "test:verification": "node --test scripts/verify.test.mjs",
    "verify:product": "node scripts/verify.mjs --profile product"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.14.3",
    "@playwright/cli": "0.1.22",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "proper-lockfile": "4.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "tailwindcss-animate": "1.0.7"
  }
}
