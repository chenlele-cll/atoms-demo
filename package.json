{
  "name": "atoms-demo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @atoms/frontend dev",
    "dev:backend": "pnpm --filter @atoms/backend dev",
    "openspec": "XDG_CONFIG_HOME=\"$PWD/.config\" openspec",
    "playwright": "bash .agents/skills/playwright/scripts/playwright_cli.sh",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @atoms/backend test",
    "test:manager": "node --test scripts/manager.test.mjs",
    "test:infra": "node --test scripts/infra.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "./manager.sh doctor && pnpm check && pnpm test:infra && pnpm test:manager && pnpm smoke && pnpm openspec validate --all --strict --no-interactive",
    "smoke": "pnpm build && node scripts/smoke.cjs",
    "prepare:template": "node scripts/prepare-company-template.mjs",
    "test:template": "node --test scripts/prepare-company-template.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.14.3",
    "@playwright/cli": "0.1.22",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "proper-lockfile": "4.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "tailwindcss-animate": "1.0.7"
  }
}
