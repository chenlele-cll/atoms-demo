# Optional: copy to backend/.env. Defaults work without configuration.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=../data/atoms.sqlite
# Exact origins, comma-separated. Public origins must all use HTTPS.
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173

# Optional model probe / future generation only. Health/startup need no API key.
# Configure credentials for the selected API service; never use a ChatGPT token.
OPENAI_API_KEY=
# Official endpoint by default; also supports the explicitly approved compatible service.
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-6.1-sol
# Complete-operation deadline: 0 disables it (default); positive 1000-2147483647ms is opt-in.
MODEL_TIMEOUT_MS=0
# Each request, including reasoning budget where applicable: 256-8192.
MODEL_MAX_OUTPUT_TOKENS=4096
