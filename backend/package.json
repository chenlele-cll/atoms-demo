{
  "name": "@atoms/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "model:probe": "tsx src/model/probe.ts",
    "model:probe:built": "node dist/model/probe.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "@ai-sdk/openai": "4.0.96",
    "ai": "7.0.143",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.15"
  }
}
