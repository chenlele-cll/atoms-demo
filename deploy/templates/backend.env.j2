# systemd EnvironmentFile syntax; deploy root:root mode 0600 in DEP-003.
# Keep private model settings in this file only; never in frontend or release.json.
NODE_ENV=production
HOST=127.0.0.1
PORT={{ atoms_config.backend_port }}
DATABASE_PATH={{ atoms_root }}/shared/data/atoms.sqlite
APP_ORIGINS=https://{{ ansible_host }}:{{ atoms_config.https_port }}
# Optional model variables are documented by backend/.env.example.
# DEP-003 must preserve locally configured secrets during updates.
